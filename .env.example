# Copy this file to .env (which is git-ignored) and fill in real values.
# After editing, restart `npx expo start` — EXPO_PUBLIC_* vars are bundled
# at build time, so hot reload won't pick up new values.

# --- STT ---
# Speech-to-text provider:
#   aliyun-qwen  (default) — backend proxy → Aliyun DashScope qwen3-asr-flash.
#                            No client-side key. Use this in production.
#   whisper                — dev-only path to a local Whisper server.
#                            Set EXPO_PUBLIC_WHISPER_ENDPOINT below.
EXPO_PUBLIC_STT_PROVIDER=aliyun-qwen

# Optional, only when STT_PROVIDER=whisper. Run scripts/local_whisper_server.py
# on port 8090 and point this at it. For a physical device on the same Wi-Fi,
# use your Mac's LAN IP instead of localhost, e.g. http://192.168.x.x:8090/...
# EXPO_PUBLIC_WHISPER_ENDPOINT=http://localhost:8090/v1/audio/transcriptions

# Note: the legacy EXPO_PUBLIC_OPENAI_API_KEY and EXPO_PUBLIC_DASHSCOPE_API_KEY
# fields used to live here. Both were removed in P10 — production STT goes
# through the backend proxy now (server-side DASHSCOPE_API_KEY), and shipping
# any third-party API key inside the JS bundle is a security mistake we
# don't repeat.

# --- Xiaomi MiMo (legacy direct-call key — DO NOT SET in new builds) ---
# Production analyze + TTS go through the backend proxy. This var is kept
# in the example only to flag that older builds may have read it.
EXPO_PUBLIC_MIMO_API_KEY=

# --- Backend (set after deploying photospeak-backend) ---
# Mobile -> backend base URL (Hono app, terminated by nginx + Let's
# Encrypt). Required.
EXPO_PUBLIC_API_BASE=https://api.dailyphotospeak.cn

# ⚠️ DEPRECATED — leave empty in new builds.
# This was the legacy shared bearer used before per-user JWT was added.
# Current code (src/api/backend.ts) does NOT read this; auth tokens come
# from /auth/* and live in expo-secure-store. The variable is kept here
# only because some historical IPA/APK builds still send it. Once those
# decay below threshold the backend's APP_SHARED_TOKEN check is removed
# (see docs/optimization.md S1) and this line goes away too.
EXPO_PUBLIC_API_TOKEN=

# --- Sentry (optional but recommended for TestFlight / production) ---
# Sign up at https://sentry.io, create a React Native project, copy
# the DSN here. Without this set, Sentry init is skipped (so dev /
# pre-Sentry-account builds run cleanly).
EXPO_PUBLIC_SENTRY_DSN=
