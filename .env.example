# Copy this file to .env (which is git-ignored) and fill in real values.
# After editing, restart `npx expo start` — EXPO_PUBLIC_* vars are bundled
# at build time, so hot reload won't pick up new values.

# --- STT (Step 5) ---
# Pick which speech-to-text backend to use:
#   whisper      (default) — local openai-whisper or OpenAI Whisper API
#   aliyun-qwen  — Alibaba DashScope qwen3-asr-flash (sync, base64 upload)
EXPO_PUBLIC_STT_PROVIDER=whisper

# --- Whisper (when STT_PROVIDER=whisper) ---
# CLOUD: leave WHISPER_ENDPOINT empty and put a real OpenAI key here.
EXPO_PUBLIC_OPENAI_API_KEY=
# LOCAL: run scripts/local_whisper_server.py (port 8090) and set:
# EXPO_PUBLIC_WHISPER_ENDPOINT=http://localhost:8090/v1/audio/transcriptions
# (For a physical device on the same Wi-Fi, use your Mac's LAN IP instead
# of localhost, e.g. http://192.168.x.x:8090/...)

# --- Aliyun DashScope (when STT_PROVIDER=aliyun-qwen) ---
# Sign in to https://bailian.console.aliyun.com, create an API key, paste here.
EXPO_PUBLIC_DASHSCOPE_API_KEY=

# --- Xiaomi MiMo (Step 6+: image+text analysis, likely TTS later) ---
EXPO_PUBLIC_MIMO_API_KEY=
