# Copy this file to .env (which is git-ignored) and fill in real values.
# After editing, restart `npx expo start` — EXPO_PUBLIC_* vars are bundled
# at build time, so hot reload won't pick up new values.
# Volcengine Ark, TTS, and ASR credentials belong only in backend/.env.

# --- STT ---
# Speech-to-text provider:
#   backend-streaming (default) — one-use backend relay ticket → configured
#                                 streaming ASR adapter. No provider key reaches
#                                 the phone.
#   whisper                     — dev-only local Whisper-compatible server.
# Never add a Volcengine key to this mobile environment file.
EXPO_PUBLIC_STT_PROVIDER=backend-streaming

# Optional, only when STT_PROVIDER=whisper. Run scripts/local_whisper_server.py
# on port 8090 and point this at it. For a physical device on the same Wi-Fi,
# use your Mac's LAN IP instead of localhost, e.g. http://192.168.x.x:8090/...
# EXPO_PUBLIC_WHISPER_ENDPOINT=http://localhost:8090/v1/audio/transcriptions

# Provider keys must never use EXPO_PUBLIC_*: those variables are compiled
# into the mobile bundle. Analysis, synthesis and production ASR all use the
# authenticated PhotoSpeak backend.

# --- Backend (set after deploying photospeak-backend) ---
# Mobile -> backend base URL (Hono app, terminated by nginx + Let's
# Encrypt). Required.
EXPO_PUBLIC_API_BASE=https://api.dailyphotospeak.cn

# --- Sentry (optional but recommended for TestFlight / production) ---
# Sign up at https://sentry.io, create a React Native project, copy
# the DSN here. The SDK initializes only after current-policy consent and the
# device-level diagnostics preference; users can opt out in Account. Without
# this set, diagnostics remain fully disabled.
EXPO_PUBLIC_SENTRY_DSN=

# --- Store screenshot preview (local development only) ---
# Enables deterministic sample content without a real login so screenshots can
# be captured from an iOS Simulator. The code also requires __DEV__, but keep
# this unset for TestFlight, App Store, and production builds.
# EXPO_PUBLIC_STORE_PREVIEW=1
