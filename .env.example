# Copy this file to .env (which is git-ignored) and fill in real values.
# After editing, restart `npx expo start` — EXPO_PUBLIC_* vars are bundled
# at build time, so hot reload won't pick up new values.

# --- Whisper (Step 5: STT) ---
# Two modes: cloud (OpenAI) or local server.
#
# CLOUD: leave EXPO_PUBLIC_WHISPER_ENDPOINT empty and put a real key here.
EXPO_PUBLIC_OPENAI_API_KEY=
#
# LOCAL: run scripts/local_whisper_server.py and set the endpoint below.
# In that mode, the API key is sent but not validated, so any non-empty
# string works. iOS Simulator can reach localhost; a physical device needs
# your Mac's LAN IP (e.g. http://192.168.1.50:8081/...).
# EXPO_PUBLIC_WHISPER_ENDPOINT=http://localhost:8081/v1/audio/transcriptions

# --- Xiaomi MiMo (Step 6+: image+text analysis, likely TTS later) ---
EXPO_PUBLIC_MIMO_API_KEY=
