# Copy to .env (gitignored) and fill in real values.
# In production these are set via PM2 ecosystem.config.js → env or
# directly in the systemd unit, NOT this file.

PORT=3000

MIMO_API_KEY=
DASHSCOPE_API_KEY=

# Long random string. Mobile app sends this in:
#   Authorization: Bearer <APP_SHARED_TOKEN>
# Generate one with: openssl rand -hex 32
APP_SHARED_TOKEN=
