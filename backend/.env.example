# Copy to .env (gitignored), fill in values, and keep it mode 0600.
# Never expose any value below through EXPO_PUBLIC_*.

PORT=3000
DATABASE_URL=postgresql://user:password@localhost:5432/photospeak
DB_POOL_MAX=5
TRUST_PROXY=false
# Set these during protocol cutovers so incompatible binaries receive 426.
# For v2 AI idempotency, first ship a newly incremented build, then set that
# build as the minimum; do not reuse an already-distributed beta build number.
# Leave a platform at 0 only if it is not live.
MIN_IOS_CLIENT_BUILD=4
MIN_ANDROID_CLIENT_BUILD=0

# ── PhotoSpeak sessions ───────────────────────────────────────────
# Generate a high-entropy value of at least 32 characters.
JWT_SECRET=
JWT_ISSUER=photospeak-api
JWT_AUDIENCE=photospeak-mobile
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d
AUTH_RECENT_MAX_AGE_SECONDS=600
# Independent server-only key for pseudonymous log correlation. If empty, the
# backend falls back to JWT_SECRET. Generate with: openssl rand -base64 32
LOG_REFERENCE_KEY=

# ── Billable AI operation idempotency ─────────────────────────────
# Generate independent keys with: openssl rand -base64 32
AI_IDEMPOTENCY_ACTIVE_KEY_ID=primary
AI_IDEMPOTENCY_KEY_RING={"primary":"<32-byte-standard-base64>"}
AI_IDEMPOTENCY_HMAC_ACTIVE_KEY_ID=primary
AI_IDEMPOTENCY_HMAC_KEY_RING={"primary":"<independent-32-byte-standard-base64>"}
# Normally empty. After any point-in-time/dump restore, set this permanently to
# the UTC time traffic was stopped for that recovery (never move it backward).
# Unknown keys through cutoff + 10 minutes fail closed to cover mobile clock
# skew; see docs/disaster-recovery.md before reopening traffic.
AI_IDEMPOTENCY_RECOVERY_FENCE_CUTOFF=

# ── Sign in with Apple server integration ─────────────────────────
APPLE_BUNDLE_ID=com.yining.photospeak
APPLE_TEAM_ID=
APPLE_KEY_ID=
# PKCS#8 .p8 contents; literal \n separators are accepted.
APPLE_PRIVATE_KEY_PEM=
# Exactly 32 random bytes in standard base64: openssl rand -base64 32
APPLE_TOKEN_ENCRYPTION_KEY=
APPLE_TOKEN_ENCRYPTION_KEY_ID=primary
# JSON key ring used only while rotating old envelope keys, for example:
# APPLE_TOKEN_DECRYPTION_KEYS={"previous":"<32-byte-standard-base64>"}
APPLE_TOKEN_DECRYPTION_KEYS=
# Optional for a Services ID/web flow; native flow normally leaves both unset.
APPLE_CLIENT_ID=
APPLE_REDIRECT_URI=
APPLE_HTTP_TIMEOUT_MS=10000

# ── App Store subscriptions / Server Notifications V2 ───────────
# Numeric App Store Connect app id (not the bundle id).
APPLE_APP_ID=6766077591
# Comma-separated paths, resolved from the backend working directory. These
# public Apple roots are committed under certs/ and must not be replaced with
# a downloaded leaf/intermediate certificate.
APPLE_ROOT_CA_PATHS=certs/AppleRootCA-G2.cer,certs/AppleRootCA-G3.cer
# Enables certificate expiry and revocation checks in Apple's official server
# library. Keep true in production; it requires outbound HTTPS/OCSP access.
APPLE_IAP_ONLINE_CHECKS=true

# ── Provider-neutral vision/text gateway ──────────────────────────
# Recommended production start: Doubao Seed 2.1 Turbo. It accepts text and image
# input and is the lower-latency/lower-cost default for PhotoSpeak. Create the
# API key in Ark Console; never expose it to the mobile app.
AI_CHAT_PROVIDER=volcengine-ark
AI_CHAT_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
AI_CHAT_API_KEY=
AI_CHAT_MODEL=doubao-seed-2-1-turbo-260628
AI_CHAT_AUTH_STYLE=bearer
AI_CHAT_MAX_TOKENS_FIELD=max_completion_tokens
# PhotoSpeak needs fast, deterministic coaching JSON rather than a reasoning
# trace. Seed 2.1 enables thinking by default, so explicitly disable it.
AI_CHAT_THINKING=disabled
AI_CHAT_TIMEOUT_MS=60000

# ── Speech synthesis ──────────────────────────────────────────────
# For Doubao TTS 2.0 use volcengine-v3-http. It has a separate speech API key
# and resource entitlement; the Ark key is not interchangeable. The default
# below is Vivi 2.0, a Chinese/English bilingual TTS 2.0 voice. If your console
# has not authorized it, replace the value with an authorized TTS 2.0 speaker ID,
# not the speaker's display name and not a legacy Moon-series voice.
AI_TTS_PROVIDER=volcengine-speech
AI_TTS_ADAPTER=volcengine-v3-http
AI_TTS_RESOURCE_ID=seed-tts-2.0
AI_TTS_API_KEY=
AI_TTS_VOICE=zh_female_vv_uranus_bigtts
AI_TTS_FORMAT=mp3
AI_TTS_TIMEOUT_MS=60000
# The fields below are required only by the legacy chat-completions adapter.
AI_TTS_BASE_URL=
AI_TTS_MODEL=
AI_TTS_AUTH_STYLE=bearer

# ── Streaming speech-recognition relay ────────────────────────────
# Use the key created in the Volcengine Speech console (not the Ark key). You
# may intentionally put the same PhotoSpeak speech key in AI_TTS_API_KEY and
# AI_ASR_API_KEY, while retaining separate variables for later key rotation.
AI_ASR_PROVIDER=volcengine-seed
AI_ASR_API_KEY=
AI_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
AI_ASR_WS_URL=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_async
# true keeps low-latency partial results and enables the more accurate second
# pass. Packet size follows Volcengine's recommended 200 ms duplex cadence.
AI_ASR_ENABLE_NONSTREAM=true
AI_ASR_VAD_SILENCE_MS=800
AI_ASR_PACKET_MS=200
TRANSCRIBE_MAX_CONCURRENCY=12

# ── Public privacy disclosure ─────────────────────────────────────
# These values are displayed to users, so keep them truthful.
AI_PROVIDER_DISPLAY_NAME=火山引擎（豆包大模型/方舟）
AI_PROVIDER_PRIVACY_URL=https://www.volcengine.com/docs/6256/64902?lang=zh
# Required for deployment. Copy the actual processing/storage region shown by
# your Sentry organization/project; do not guess it.
SENTRY_DATA_REGION=
# Match the retention configured for your actual Sentry plan/project.
SENTRY_RETENTION_DAYS=30

# ── Backup job (read by scripts/backup.sh, not the API process) ───
BACKUP_DIR=/var/backups/photospeak
RETENTION_DAYS=7
BACKUP_OFFSITE_URI=oss://private-bucket/photospeak/postgres
BACKUP_REQUIRE_OFFSITE=1
BACKUP_FAILURE_WEBHOOK_URL=

# Restore-drill-only inputs (read by scripts/restore-drill.sh). Keep these
# unset in the API service. BACKUP_OBJECT_URI must identify one exact dump;
# RESTORE_DRILL_DATABASE_URL must only point to a disposable empty database.
BACKUP_OBJECT_URI=
RESTORE_DRILL_DATABASE_URL=
RESTORE_DRILL_CONFIRM_EMPTY_DATABASE=

# ── Abuse and cost safety controls ────────────────────────────────
AI_REQUESTS_PER_MINUTE=60
AI_GLOBAL_CONCURRENCY=4
AI_FREE_DAILY_SAFETY_LIMIT=200
AI_PLUS_DAILY_SAFETY_LIMIT=1000
# Billing-currency units. Empty disables the cost breaker.
AI_FREE_DAILY_COST_LIMIT=
AI_PLUS_DAILY_COST_LIMIT=
# Conservative public list prices as of 2026-09-22. Update these if your Ark
# contract or resource pack has different effective rates. Ark units are tokens.
AI_CHAT_INPUT_PRICE_PER_MILLION=3
AI_CHAT_OUTPUT_PRICE_PER_MILLION=15
# Unit follows the selected adapter: Volcengine V3 reports Unicode characters;
# chat-completions reports tokens. Convert vendor prices to a per-million rate.
# Seed-TTS 2.0 public list price is CNY 5 / 10,000 characters.
AI_TTS_INPUT_PRICE_PER_MILLION=500
AI_TTS_OUTPUT_PRICE_PER_MILLION=0
# Seed ASR duration billing, CNY per audio hour. Update this when your console
# or resource pack shows a different effective rate; empty disables estimates.
AI_ASR_PRICE_PER_HOUR=0.8
AI_BILLING_CURRENCY=CNY

# ── Retention jobs ────────────────────────────────────────────────
ACCOUNT_DELETE_RETENTION_DAYS=7
AI_USAGE_RETENTION_DAYS=400

# ── Optional phone login ──────────────────────────────────────────
PHONE_LOGIN_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ── Apple App Review login ────────────────────────────────────────
# Dedicated, revocable review credential. The sentinel is deliberately not a
# routable mainland mobile number, so it cannot shadow a customer's account.
# Keep disabled outside an active review window. Never commit the six-digit
# plaintext code; store only its HMAC. The HMAC is keyed with JWT_SECRET.
APP_REVIEW_ACCESS_ENABLED=false
APP_REVIEW_PHONE=10000000000
APP_REVIEW_CODE_HMAC=

# ── Account-deletion receipt signing ──────────────────────────────
# Keep retired keys for at least 400 days after their last issuance.
DELETION_RECEIPT_CURRENT_KID=2026-09
DELETION_RECEIPT_KEYS={"2026-09":"<openssl rand -base64 32>"}
