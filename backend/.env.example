# Copy to .env (gitignored) and fill in real values.
# Same file works for local dev AND production — PM2 reads it via
# dotenv at startup. .gitignore already excludes .env.

PORT=3000

# ── Upstream API keys (proxied by /api/*) ─────────────────────────
MIMO_API_KEY=
DASHSCOPE_API_KEY=

# ── Legacy bearer (transition only) ───────────────────────────────
# Pre-auth mobile builds put this in Authorization: Bearer <token>.
# Once every released build is on JWT, delete this line and require
# JWT for all /api/* calls.
# Generate with: openssl rand -hex 32
APP_SHARED_TOKEN=

# ── Postgres ──────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/photospeak

# ── JWT (signs per-user access + refresh tokens) ──────────────────
# REQUIRED. >= 32 chars. Generate with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── Apple Sign-In ────────────────────────────────────────────────
# Must equal the iOS app's bundleIdentifier (in app.json).
# Apple signs identity tokens with this as the `aud` claim.
APPLE_BUNDLE_ID=com.yining.photospeak

# ── Phone login (Aliyun dypnsapi · 短信认证) ─────────────────────
# Master switch. Flip to true after the Aliyun keys + signature +
# template below are filled. Until then /auth/send-code returns 403.
PHONE_LOGIN_ENABLED=false
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
