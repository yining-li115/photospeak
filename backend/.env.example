# Copy to .env (gitignored) and fill in real values.
# Same file works for local dev AND production — PM2 reads it via
# dotenv at startup. .gitignore already excludes .env.

PORT=3000

MIMO_API_KEY=
DASHSCOPE_API_KEY=

# Long random string. Mobile app sends this in:
#   Authorization: Bearer <APP_SHARED_TOKEN>
# Generate one with: openssl rand -hex 32
APP_SHARED_TOKEN=
